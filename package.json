{
  "name": "neurodiversity-test",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Frontend for a neurodiversity trait-profile test, driven by a versioned question bank, type set and scoring mechanism.",
  "scripts": {
    "dev": "vite",
    "build": "npm run validate && tsc --noEmit && vite build",
    "preview": "vite preview",
    "validate": "tsx scripts/validate-content.ts",
    "simulate": "tsx scripts/simulate.ts",
    "analyze": "tsx scripts/analyze-responses.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "verify-refs": "tsx scripts/verify-references.ts",
    "docs": "tsx scripts/build-docs.ts"
  },
  "dependencies": {
    "js-yaml": "^5.5.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.11",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.4.0",
    "vitest": "^5.1.2"
  }
}
